{
  "name": "Japan Trip Planner",
  "short_name": "Japan Trip",
  "start_url": "./index.html#/day",
  "scope": "./",
  "display": "standalone",
  "background_color": "#faf7f2",
  "theme_color": "#c8102e",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "plan", "accept": ["application/json", "text/plain", "application/octet-stream", ".json", ".txt"] }]
    }
  }
}
